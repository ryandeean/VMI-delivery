# ---------------------------------------------------------------------------
# VMI Delivery Scheduler - environment configuration
# Copy this file to .env and fill in what you have. Everything is optional:
# the app runs in demo mode with sample data until you add real credentials.
# ---------------------------------------------------------------------------

# Database (SQLite file by default). For Postgres see README.
DATABASE_URL="file:./dev.db"

# Shared login password for the dispatch screens (leave blank to disable login in development).
APP_PASSWORD=""
# Random string used to sign login cookies and driver links.
APP_SECRET="change-me-to-a-long-random-string"
# Public URL of the app (used in emails and calendar links), e.g. https://deliveries.vmi.tv. Not needed on Render.
APP_URL="http://localhost:3000"

# --- Current RMS -----------------------------------------------------------
# System Setup > Integrations > API in Current RMS.
CURRENT_RMS_SUBDOMAIN=""
CURRENT_RMS_API_KEY=""
# Which opportunity states count as confirmed work (comma separated, case-insensitive).
CURRENT_RMS_IMPORT_STATES="order,reserved"
# Optional: name of a custom field on the opportunity that says whether delivery is needed
# (e.g. "delivery_method"). Leave blank to import every confirmed order.
CURRENT_RMS_DELIVERY_FIELD=""
CURRENT_RMS_DELIVERY_VALUES="delivery,deliver,delivery & collection,courier"
# Optional: custom field names on products holding volume (m3) and weight (kg).
CURRENT_RMS_VOLUME_FIELD=""
CURRENT_RMS_WEIGHT_FIELD=""

# --- Google Maps -----------------------------------------------------------
# Server key: enable "Routes API" and "Geocoding API". Restrict by IP if you can.
GOOGLE_MAPS_API_KEY=""
# Browser key for the map on the dispatch screen: enable "Maps JavaScript API", restrict by website.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# Map ID (optional) for advanced markers; create one in Google Cloud > Maps > Map Management.
NEXT_PUBLIC_GOOGLE_MAP_ID=""

# --- Google Calendar -------------------------------------------------------
# Option A (recommended, Google Workspace): a service account with the calendar shared to it.
# Paste the JSON key as a single line, or base64-encode it.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# If your Workspace admin enabled domain-wide delegation, the user to act as (lets us invite drivers).
GOOGLE_CALENDAR_IMPERSONATE=""
# Option B: OAuth client + refresh token for a normal Google account.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
# The calendar to write runs into (share it with every driver). "primary" = the account's own calendar.
GOOGLE_CALENDAR_ID=""

# --- Email (SMTP) ------------------------------------------------------------
# Works with Google Workspace (smtp.gmail.com, app password), Microsoft 365, SendGrid, Postmark, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="VMI Deliveries <deliveries@example.com>"

# Secret for the scheduled sync endpoint (/api/cron/sync). Send as "Authorization: Bearer <secret>".
CRON_SECRET=""
