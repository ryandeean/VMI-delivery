// VMI Delivery Scheduler - database schema
// SQLite by default (zero setup). To use Postgres, change provider to "postgresql"
// and point DATABASE_URL at your database, then run `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Single-row company settings (id is always 1).
model Settings {
  id                     Int      @id @default(1)
  companyName            String   @default("VMI")
  timezone               String   @default("Europe/London")
  depotName              String   @default("VMI Warehouse")
  depotAddress           String   @default("")
  depotLat               Float?
  depotLng               Float?
  dayStart               String   @default("07:00")
  dayEnd                 String   @default("19:00")
  loadingMinutes         Int      @default(30)
  defaultServiceMinutes  Int      @default(20)
  startBufferMinutes     Int      @default(15)
  packingFactor          Float    @default(1.3)
  defaultItemVolumeM3    Float    @default(0.05)
  defaultItemWeightKg    Float    @default(5)
  clientEtaWindowMinutes Int      @default(60)
  maxStopsPerRun         Int      @default(10)
  maxRunHours            Float    @default(9)
  dispatchEmail          String   @default("")
  dispatchPhone          String   @default("")
  updatedAt              DateTime @updatedAt
}

model Vehicle {
  id               String   @id @default(cuid())
  name             String
  registration     String   @default("")
  vehicleClass     String
  capacityVolumeM3 Float
  capacityWeightKg Float
  licenceRequired  String   @default("B")
  active           Boolean  @default(true)
  notes            String   @default("")
  runs             Run[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Driver {
  id                String          @id @default(cuid())
  name              String
  email             String          @default("")
  phone             String          @default("")
  licenceCategories String          @default("B")
  workingDays       String          @default("1,2,3,4,5")
  portalToken       String          @unique @default(cuid())
  active            Boolean         @default(true)
  notes             String          @default("")
  absences          DriverAbsence[]
  runs              Run[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model DriverAbsence {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startDate String
  endDate   String
  reason    String   @default("")
  createdAt DateTime @default(now())
}

/// A delivery or collection at a client address. Usually created from a Current RMS opportunity.
model Job {
  id                   String    @id @default(cuid())
  type                 String
  source               String    @default("MANUAL")
  externalId           String?   @unique
  opportunityId        Int?
  opportunityNumber    String    @default("")
  subject              String    @default("")
  clientName           String
  contactName          String    @default("")
  contactPhone         String    @default("")
  contactEmail         String    @default("")
  secondaryContacts    String    @default("[]")
  accountHandlerName   String    @default("")
  accountHandlerEmail  String    @default("")
  addressLine1         String    @default("")
  addressLine2         String    @default("")
  city                 String    @default("")
  postcode             String    @default("")
  country              String    @default("United Kingdom")
  lat                  Float?
  lng                  Float?
  date                 String
  windowStart          DateTime?
  windowEnd            DateTime?
  serviceMinutes       Int       @default(20)
  volumeM3             Float     @default(0)
  weightKg             Float     @default(0)
  itemCount            Int       @default(0)
  items                String    @default("[]")
  loadOverride         Boolean   @default(false)
  requiredVehicleClass String    @default("SMALL_VAN")
  status               String    @default("UNSCHEDULED")
  notes                String    @default("")
  driverNotes          String    @default("")
  clientNotify         Boolean   @default(true)
  runId                String?
  run                  Run?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  sequence             Int       @default(0)
  plannedArrival       DateTime?
  plannedDeparture     DateTime?
  legDistanceM         Int       @default(0)
  legDurationS         Int       @default(0)
  waitS                Int       @default(0)
  lateS                Int       @default(0)
  liveEta              DateTime?
  enRouteAt            DateTime?
  arrivedAt            DateTime?
  completedAt          DateTime?
  outcome              String    @default("")
  podName              String    @default("")
  podNotes             String    @default("")
  lastClientEmailAt    DateTime?
  notifications        NotificationLog[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([date])
  @@index([runId])
}

/// One driver + one vehicle + an ordered list of stops on a given day.
model Run {
  id              String    @id @default(cuid())
  date            String
  driverId        String?
  driver          Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId       String?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status          String    @default("DRAFT")
  plannedStart    DateTime?
  plannedEnd      DateTime?
  startLocked     Boolean   @default(false)
  manualOrder     Boolean   @default(false)
  totalDistanceM  Int       @default(0)
  totalDurationS  Int       @default(0)
  polyline        String    @default("")
  routeSource     String    @default("")
  optimisedAt     DateTime?
  calendarEventId String    @default("")
  publishedAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String    @default("")
  jobs            Job[]
  notifications   NotificationLog[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([date])
}

/// Every email the system sends (or would send, when email is not configured yet).
model NotificationLog {
  id        String   @id @default(cuid())
  kind      String
  channel   String   @default("EMAIL")
  recipient String
  subject   String
  body      String
  status    String
  error     String   @default("")
  runId     String?
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Remembered size/weight per Current RMS product, so sizing gets smarter over time.
model ProductProfile {
  id            String   @id @default(cuid())
  currentItemId Int      @unique
  name          String
  volumeM3      Float?
  weightKg      Float?
  source        String   @default("CURRENT_RMS")
  updatedAt     DateTime @updatedAt
}

model SyncLog {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING")
  message    String    @default("")
  created    Int       @default(0)
  updated    Int       @default(0)
  skipped    Int       @default(0)
}
